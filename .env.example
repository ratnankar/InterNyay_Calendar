# Address of the InterNyay backend (must end with /api). Change this to your AWS server address.
# Expo reads this file automatically; restart with: npx expo start -c
EXPO_PUBLIC_API_BASE_URL=

# Google sign-in (optional). Leave empty to hide the "Continue with Google" button.
# Web client ID from Google Cloud Console (type "Web application"); the backend must accept tokens issued for it.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS client ID and its reversed form (com.googleusercontent.apps.<id>), both from the iOS OAuth client
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=

# Preview with sample hearings, no sign-in and no server (1 = on). Same as: EXPO_PUBLIC_DEMO=1 npm run web
# EXPO_PUBLIC_DEMO=
