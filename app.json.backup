{
  "expo": {
    "name": "InterNyay Calendar",
    "slug": "internyay-calendar",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.internyay.calendar",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A1628",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.internyay.calendar"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "name": "InterNyay Calendar",
      "shortName": "InterNyay",
      "description": "View your court hearings on a month calendar.",
      "themeColor": "#0A1628",
      "backgroundColor": "#FFFFFF",
      "display": "standalone"
    },
    "plugins": [
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "337cccd3-c57e-420d-8b98-894951bb9ff9"
      }
    },
    "description": "View your court hearings on a month calendar."
  }
}
